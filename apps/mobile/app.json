{
  "expo": {
    "name": "TallZ",
    "slug": "tallz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/tallz-mark.png",
    "scheme": "tallz",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tallz.app"
    },
    "android": {
      "package": "com.tallz.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/tallz-mark.png",
        "monochromeImage": "./assets/tallz-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "expo-image",
      "expo-font",
      "expo-localization"
    ],
    "splash": {
      "image": "./assets/tallz-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    }
  }
}
